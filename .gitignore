# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# docs — material de negocio e documentacao de trabalho ficam fora do repo
docs/

# smoke test output — contém secret keys, NUNCA commitar
# padrão em vez de lista: um smoke novo já nasce ignorado
smoke-*-output.json
scripts/video/state.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
test-results/

# Artefatos pessoais (análises, pitch decks, social media)
/Plina_Finance_*.html
/Plina_Finance_*.pdf
/Plina_Finance_*.md
/Plina_Pitch_Deck.html
/linkedin-header.html

# Material de estudo local
/tutorial-stellar*

# Exports locais (logos LinkedIn + patches gerados pro fork)
/exports/

# Checkouts paralelos do projeto (clones em layout monorepo) e cache stale
/plina-finance/
/plina-landing/

# Docs de implementação locais (notas de trabalho, não versionadas)
docs/M0-foundation-fase1.md

# stellar-build / BMAD — camadas pessoais (o resto do .stellar-build é versionado)
.stellar-build/**/*.user.toml
.stellar-build/**/*.user.yaml
.stellar-build/scripts/__pycache__/

# fontes embutidas do dossiê (regeneráveis)
scripts/dossie/fonts/
