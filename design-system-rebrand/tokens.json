{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Plina Rebrand Design System v2.0 — CANDIDATE. Derived from 'Plina Landing v3 - Rebrand.dc.html'. Does NOT supersede design-system/tokens.json until officialised.",
  "meta": {
    "name": {
      "$type": "string",
      "$value": "Plina Rebrand Design System"
    },
    "version": {
      "$type": "string",
      "$value": "2.1.0-candidate"
    },
    "status": {
      "$type": "string",
      "$value": "candidate — not official; design-system/ remains authoritative"
    },
    "derivedFrom": {
      "$type": "string",
      "$value": "Plina landing page nova/Plina Landing v3 - Rebrand.dc.html"
    }
  },
  "color": {
    "surface": {
      "deep": {
        "$type": "color",
        "$value": "#0C1719",
        "$description": "Petrol Deep. The base canvas. Dark-first: this is the default surface of the brand, not an accent."
      },
      "raised": {
        "$type": "color",
        "$value": "#122224",
        "$description": "Petrol Raised. Cards and panels sitting on deep. The only elevation step on dark."
      },
      "recess": {
        "$type": "color",
        "$value": "#0A1214",
        "$description": "Petrol Recess. Announcement bar and inset wells. Reads as behind the page."
      },
      "pale": {
        "$type": "color",
        "$value": "#EDF3F2",
        "$description": "Mist White. The light surface — closing sections only (FAQ, lead capture)."
      },
      "sheet": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "Sheet White. Cards, forms and fields sitting on pale. Never a full section."
      }
    },
    "ink": {
      "on-dark": {
        "$type": "color",
        "$value": "#EDF3F2",
        "$description": "Headings and emphatic text on any dark surface."
      },
      "on-dark-body": {
        "$type": "color",
        "$value": "rgba(237,243,242,0.65)",
        "$description": "Body copy on dark. Floor for readable paragraphs."
      },
      "on-dark-muted": {
        "$type": "color",
        "$value": "rgba(237,243,242,0.55)",
        "$description": "Eyebrows, captions, metadata, numerals at rest. Floor for any text at all."
      },
      "on-dark-faint": {
        "$type": "color",
        "$value": "rgba(237,243,242,0.25)",
        "$description": "Decorative only. Never carries meaning."
      },
      "on-light": {
        "$type": "color",
        "$value": "#132728",
        "$description": "Base Plina. Headings and body on pale/sheet. Shared with the official system."
      },
      "on-light-body": {
        "$type": "color",
        "$value": "rgba(19,39,40,0.7)",
        "$description": "Body copy on light."
      },
      "on-light-muted": {
        "$type": "color",
        "$value": "rgba(19,39,40,0.65)",
        "$description": "Captions and metadata on light. Floor for text on light — 0.60 fails AA on pale (4.06) and must not be used."
      },
      "on-light-faint": {
        "$type": "color",
        "$value": "rgba(19,39,40,0.2)",
        "$description": "Decorative only."
      },
      "on-signal": {
        "$type": "color",
        "$value": "{color.ink.on-light}",
        "$description": "MANDATORY text colour on an Action Cyan fill. White on cyan is forbidden."
      }
    },
    "signal": {
      "500": {
        "$type": "color",
        "$value": "#0EA7C7",
        "$description": "Action Cyan. Ink on dark surfaces, and every cyan fill. The metric colour."
      },
      "700": {
        "$type": "color",
        "$value": "#046C88",
        "$description": "Cyan ink and focus ring on pale/sheet. The only cyan legal on light."
      }
    },
    "support": {
      "glacier": {
        "$type": "color",
        "$value": "#A0CFE7",
        "$description": "Detail Mist. Qualifier chips, secondary emphasis on dark. Never on light."
      }
    },
    "hairline": {
      "section": {
        "$type": "color",
        "$value": "rgba(237,243,242,0.08)",
        "$description": "Rule between dark sections. The only structural separator on dark."
      },
      "frame": {
        "$type": "color",
        "$value": "rgba(237,243,242,0.1)",
        "$description": "Border of a raised card, and rows inside it."
      },
      "divider": {
        "$type": "color",
        "$value": "rgba(237,243,242,0.12)",
        "$description": "Row separator inside a list or accordion."
      },
      "quiet": {
        "$type": "color",
        "$value": "rgba(237,243,242,0.15)",
        "$description": "Border of a quiet button on dark, at rest."
      },
      "glacier": {
        "$type": "color",
        "$value": "rgba(160,207,231,0.3)",
        "$description": "Border of a glacier chip."
      },
      "signal": {
        "$type": "color",
        "$value": "rgba(14,167,199,0.45)",
        "$description": "Border of a cyan chip."
      },
      "on-light": {
        "$type": "color",
        "$value": "rgba(19,39,40,0.12)",
        "$description": "Rule and card border on light."
      },
      "field": {
        "$type": "color",
        "$value": "rgba(19,39,40,0.2)",
        "$description": "Border of an input at rest."
      }
    },
    "state": {
      "focus-on-dark": {
        "$type": "color",
        "$value": "{color.signal.500}",
        "$description": "2px focus ring on any dark surface, offset 3px."
      },
      "focus-on-light": {
        "$type": "color",
        "$value": "{color.signal.700}",
        "$description": "2px focus ring on pale/sheet. Action Cyan does NOT clear 3:1 on light."
      },
      "danger": {
        "$type": "color",
        "$value": "#B3261E",
        "$description": "Errors on light surfaces only."
      },
      "danger-on-dark": {
        "$type": "color",
        "$value": "#F2B8B5",
        "$description": "Errors on dark surfaces."
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Chillax",
          "sans-serif"
        ],
        "$description": "Headlines and the marquee. Weights 500 and 600 only."
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Satoshi",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Prose. Weight 400. Set once on the root and inherited."
      },
      "label": {
        "$type": "fontFamily",
        "$value": [
          "Geist",
          "sans-serif"
        ],
        "$description": "Interface labels, step titles, buttons. Weights 500 and 600."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "Geist Mono",
          "monospace"
        ],
        "$description": "The family of facts: eyebrows, every number, numerals, ticker data."
      }
    },
    "size": {
      "display-xl": {
        "$type": "dimension",
        "$value": "clamp(2.75rem, 6.5vw, 5.5rem)",
        "$description": "h1. Once per page."
      },
      "display-l": {
        "$type": "dimension",
        "$value": "clamp(2rem, 4vw, 3.25rem)",
        "$description": "Section h2."
      },
      "numeric-xl": {
        "$type": "dimension",
        "$value": "clamp(2.75rem, 5vw, 4.25rem)",
        "$description": "Proof metrics. Always cyan, always mono."
      },
      "numeric-l": {
        "$type": "dimension",
        "$value": "clamp(2.5rem, 4vw, 3.5rem)",
        "$description": "Product yields. Always ink-on-dark, always mono."
      },
      "title-m": {
        "$type": "dimension",
        "$value": "1.375rem"
      },
      "title-s": {
        "$type": "dimension",
        "$value": "1.3125rem"
      },
      "body-l": {
        "$type": "dimension",
        "$value": "1.0625rem",
        "$description": "Default body size."
      },
      "body-m": {
        "$type": "dimension",
        "$value": "0.9375rem",
        "$description": "Secondary body: card copy, accordion answers."
      },
      "body-s": {
        "$type": "dimension",
        "$value": "0.8125rem",
        "$description": "Micro copy: announcement bar, footnotes, step rows."
      },
      "label-m": {
        "$type": "dimension",
        "$value": "0.875rem"
      },
      "label-s": {
        "$type": "dimension",
        "$value": "0.75rem",
        "$description": "Eyebrow size."
      },
      "label-xs": {
        "$type": "dimension",
        "$value": "0.6875rem",
        "$description": "Chip size."
      }
    },
    "tracking": {
      "display-xl": {
        "$type": "dimension",
        "$value": "-0.03em"
      },
      "display-l": {
        "$type": "dimension",
        "$value": "-0.025em"
      },
      "numeric-l": {
        "$type": "dimension",
        "$value": "-0.02em"
      },
      "numeric-xl": {
        "$type": "dimension",
        "$value": "-0.01em"
      },
      "eyebrow": {
        "$type": "dimension",
        "$value": "0.18em"
      },
      "numeral": {
        "$type": "dimension",
        "$value": "0.14em"
      },
      "chip": {
        "$type": "dimension",
        "$value": "0.1em"
      },
      "data": {
        "$type": "dimension",
        "$value": "0.04em"
      }
    },
    "leading": {
      "display-xl": {
        "$type": "number",
        "$value": 1.04
      },
      "display-l": {
        "$type": "number",
        "$value": 1.08
      },
      "prose": {
        "$type": "number",
        "$value": 1.65
      },
      "compact": {
        "$type": "number",
        "$value": 1.6
      },
      "numeric": {
        "$type": "number",
        "$value": 1
      }
    },
    "measure": {
      "title": {
        "$type": "dimension",
        "$value": "22ch",
        "$description": "Cap for display headings. 15ch for the h1."
      },
      "lead": {
        "$type": "dimension",
        "$value": "46ch"
      },
      "body": {
        "$type": "dimension",
        "$value": "56ch"
      },
      "long": {
        "$type": "dimension",
        "$value": "66ch",
        "$description": "Absolute ceiling. Never exceed 76ch."
      }
    }
  },
  "layout": {
    "container": {
      "$type": "dimension",
      "$value": "1240px"
    },
    "container-media": {
      "$type": "dimension",
      "$value": "1100px",
      "$description": "Hero photograph. Narrower than the text container on purpose."
    },
    "gutter": {
      "$type": "dimension",
      "$value": "clamp(24px, 5vw, 48px)"
    },
    "rhythm": {
      "hero": {
        "$type": "dimension",
        "$value": "9rem"
      },
      "section": {
        "$type": "dimension",
        "$value": "7rem"
      },
      "dense": {
        "$type": "dimension",
        "$value": "6.5rem",
        "$description": "Metric bands only."
      },
      "footer": {
        "$type": "dimension",
        "$value": "4.5rem"
      }
    },
    "grid": {
      "product": {
        "$type": "string",
        "$value": "repeat(auto-fit, minmax(320px, 1fr))"
      },
      "media": {
        "$type": "string",
        "$value": "repeat(auto-fit, minmax(300px, 1fr))"
      },
      "thesis": {
        "$type": "string",
        "$value": "repeat(auto-fit, minmax(280px, 1fr))"
      },
      "metric": {
        "$type": "string",
        "$value": "repeat(auto-fit, minmax(220px, 1fr))"
      },
      "row-3": {
        "$type": "string",
        "$value": "52px 190px 1fr",
        "$description": "Step row. MUST collapse to 52px 1fr below the `lap` breakpoint."
      },
      "row-2": {
        "$type": "string",
        "$value": "52px 1fr auto",
        "$description": "Accordion summary. Holds down to `palm`."
      }
    },
    "breakpoint": {
      "palm": {
        "$type": "dimension",
        "$value": "560px",
        "$description": "Below this, every fixed-column grid collapses to a single content column."
      },
      "lap": {
        "$type": "dimension",
        "$value": "760px",
        "$description": "Below this, step rows drop their fixed title column."
      },
      "desk": {
        "$type": "dimension",
        "$value": "960px",
        "$description": "Below this, the nav collapses to a drawer. NOT to bare links hidden."
      }
    }
  },
  "radius": {
    "media": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Photographs. The softest step: it reads as finish, not as a card."
    },
    "panel": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "A panel that carries a fill of its own. Larger than media on purpose, so a coloured panel never reads as another photograph."
    },
    "pill": {
      "$type": "dimension",
      "$value": "9999px",
      "$description": "Buttons and chips. Inherited unchanged from the official system."
    },
    "none": {
      "$type": "dimension",
      "$value": "0",
      "$description": "Tables, accordion rows, section rules and underline-only fields. Structure has no radius: only objects do."
    }
  },
  "motion": {
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.22,
        1,
        0.36,
        1
      ],
      "$description": "The only easing in the system."
    },
    "duration": {
      "control": {
        "$type": "duration",
        "$value": "250ms",
        "$description": "Colour and border changes on controls."
      },
      "icon": {
        "$type": "duration",
        "$value": "300ms",
        "$description": "The accordion plus rotation."
      },
      "rise": {
        "$type": "duration",
        "$value": "750ms"
      },
      "unmask": {
        "$type": "duration",
        "$value": "900ms"
      },
      "aperture": {
        "$type": "duration",
        "$value": "1100ms"
      },
      "count": {
        "$type": "duration",
        "$value": "1400ms"
      }
    },
    "stagger": {
      "$type": "duration",
      "$value": "90ms",
      "$description": "Delay between siblings in a revealed group."
    },
    "marquee": {
      "$type": "duration",
      "$value": "40s",
      "$description": "One full loop of the credential ticker."
    }
  }
}