{
  "name": "plina-finance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:auth-guard": "node scripts/lint/require-auth-guard.mjs",
    "postinstall": "prisma generate",
    "prebuild": "pnpm lint:auth-guard",
    "smoke:stellar": "tsx scripts/smoke-stellar.ts",
    "smoke:etherfuse": "tsx scripts/smoke-etherfuse.ts",
    "smoke:audit": "tsx scripts/smoke-audit.ts",
    "evidencia:plina-rf": "tsx scripts/gerar-evidencia-plina-rf.ts",
    "test:e2e": "playwright test",
    "test:e2e:stub": "E2E_STUB=1 playwright test --project=e2e-stub",
    "prisma:seed": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/prisma/build/index.js migrate deploy",
    "prisma:studio": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/prisma/build/index.js studio"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines"
    ],
    "//overrides": "Advisories em deps transitivas que o upgrade do pai não alcança. Pins com caret dentro do major corrente — range aberto (>=) faria o pnpm subir de major e quebrar consumidores CJS (nanoid 4+ é ESM-only). Revisar a cada `pnpm audit`; remover a entrada quando o pai já resolver sozinho.",
    "overrides": {
      "postcss": "^8.5.23",
      "nanoid": "^3.3.17",
      "sharp": "^0.35.3",
      "axios": "^1.18.0",
      "protobufjs": "^7.6.5",
      "esbuild": "^0.28.1",
      "vite": "^8.0.16",
      "form-data": "^4.0.6",
      "hono": "^4.12.34",
      "socket.io-parser": "^4.2.7",
      "uuid": "^11.1.1",
      "ws": "^8.21.0",
      "@walletconnect/jsonrpc-ws-connection>ws": "^7.5.11",
      "@vercel/blob>undici": "^6.28.0"
    }
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@prisma/client": "^6.1.0",
    "@privy-io/react-auth": "^3.37.0",
    "@privy-io/server-auth": "^1.32.5",
    "@stellar/stellar-sdk": "^13.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.7.0",
    "@vercel/edge-config": "^1.4.3",
    "@vercel/speed-insights": "^2.0.0",
    "botid": "^1.5.11",
    "dotenv": "^16.4.7",
    "lucide-react": "^1.14.0",
    "next": "16.2.12",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.10",
    "jsdom": "^30.0.1",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
